{
  "name": "@keplar/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:api": "tsx watch src/api-main.ts",
    "dev:worker": "tsx watch src/worker-main.ts",
    "start:api": "node dist/api-main.js",
    "start:worker": "node dist/worker-main.js",
    "migrate": "tsx src/db/migrate-main.ts",
    "build": "tsup src/api-main.ts src/worker-main.ts src/db/migrate-main.ts --format esm --target node22 --clean --noExternal @keplar/contracts && cp -r src/db/migrations dist/migrations",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@fastify/cookie": "11.1.3",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.6",
    "@keplar/contracts": "0.1.0",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.12.7",
    "ipaddr.js": "2.5.0",
    "pg": "8.23.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "@types/pg": "8.15.5",
    "tsup": "8.5.0",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
