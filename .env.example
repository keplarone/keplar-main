# Postgres (Neon, Supabase, Vercel Postgres...). Run `npm run db:migrate` once.
DATABASE_URL=postgres://user:pass@host:5432/keplar

# Whop
WHOP_API_KEY=                 # Company API key with payments, checkout and member permissions
WHOP_COMPANY_ID=biz_xxxxxxxxxxxxxx
WHOP_WEBHOOK_SECRET=ws_xxxxxxxx   # From the webhook you create for /api/webhooks/whop
WHOP_APP_ID=                  # Optional: checked as the user token's audience
WHOP_USER_TOKEN_PUBLIC_KEY=   # Whop's ES256 public key (PEM) for x-whop-user-token

# Which Whop plans are which tier (comma-separate monthly/yearly plans)
WHOP_PLAN_IDS_LITE=plan_xxx   # grants $4.80 per payment
WHOP_PLAN_IDS_PLUS=plan_xxx   # grants $12 per payment
WHOP_PLAN_IDS_PRO=plan_xxx    # grants $27 per payment

# One-time "buy more credits" packs: Whop plan id -> OpenRouter credit in USD
WHOP_CREDIT_PACKS={"plan_pack5":5,"plan_pack10":10,"plan_pack25":25}

# OpenRouter provisioning key (Settings -> Provisioning API keys). Not a normal API key.
OPENROUTER_PROVISIONING_KEY=

# 32 random bytes, base64: openssl rand -base64 32
KEY_ENCRYPTION_KEY=

APP_URL=https://your-app.example.com
CRON_SECRET=                  # Vercel sends this as a Bearer token to the cron route
AUTOTOPUP_MAX_PER_DAY=3       # Safety cap on automatic charges per user per day
