# Copy to .env for local development. Never commit real secrets.
NODE_ENV=development
DATABASE_URL=postgres://keplar:keplar@localhost:5432/keplar
# Origin the browser app is served from (used for CSRF origin checks and cookies).
APP_ORIGIN=http://localhost:5173
PORT=3000
# Optional. When unset, Keplar uses its built-in template composer and says so in every receipt.
ANTHROPIC_API_KEY=
# Worker tuning
WORKER_CONCURRENCY=4
WORKER_LEASE_MS=30000
